#!/bin/sh
# NexTerm Mandatory Pre-Push Git Hook
# Automatically installed via `python scripts/install_hooks.py --install`

if [ "$SKIP_GUARDIAN" = "1" ]; then
    echo "[GUARDIAN WARNING] SKIP_GUARDIAN=1 detected. Pre-push checks bypassed."
    exit 0
fi

echo ""
echo "NexTerm Pre-Push Integrity Guard"
echo "================================"

PYTHON_EXEC="python"
if [ -f "venv/Scripts/python.exe" ]; then
    PYTHON_EXEC="venv/Scripts/python.exe"
elif [ -f ".venv/Scripts/python.exe" ]; then
    PYTHON_EXEC=".venv/Scripts/python.exe"
elif [ -f "venv/bin/python" ]; then
    PYTHON_EXEC="venv/bin/python"
elif [ -f ".venv/bin/python" ]; then
    PYTHON_EXEC=".venv/bin/python"
fi

"$PYTHON_EXEC" "scripts/pre_push.py"
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "[GUARDIAN BLOCK] Push rejected by NexTerm Pre-Push Gate."
    echo "[GUARDIAN TIP] Check pre_push_report.md or pass SKIP_GUARDIAN=1 git push to bypass."
    exit $EXIT_CODE
fi

echo ""
echo "Integrity & Pre-Push Validation passed."
exit 0
